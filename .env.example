# Copy to .env (git-ignored). NEVER commit real keys.

# --- Primary LLM: any OpenAI-compatible endpoint. Default = Groq (free tier: https://console.groq.com/keys)
LLM_API_KEY=
# Optional spare Groq keys (other accounts), comma-separated: used automatically when one key's daily quota is spent
LLM_EXTRA_API_KEYS=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Model IDs change -- check the provider's model list if you get 404/400.
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_VISION_MODEL=qwen/qwen3.8-27b
STT_MODEL=whisper-large-v3-turbo
# Natural read-aloud voices for all Indian languages (free key: https://dashboard.sarvam.ai). Empty = browser voice.
SARVAM_API_KEY=
TTS_MODEL=bulbul:v3
TTS_SPEAKER=

# --- Fallback LLM (used automatically if primary rate-limits / is down). e.g. OpenRouter, Gemini's OpenAI-compat endpoint
FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional extra providers, tried in order after FALLBACK_* (same OpenAI-compatible format)
FALLBACK2_API_KEY=
FALLBACK2_BASE_URL=https://openrouter.ai/api/v1
FALLBACK2_MODEL=
FALLBACK3_API_KEY=
FALLBACK3_BASE_URL=https://openrouter.ai/api/v1
FALLBACK3_MODEL=

# --- LIVE DATA (required by FORGE rules: no dummy data) ---
# Mandi prices: free key from https://data.gov.in  (register -> My Account -> API key). Weather/soil (Open-Meteo) needs no key.
DATA_GOV_API_KEY=
# Run `make check-live` once: it prints the real field names and tells you if these need changing.
MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# auto | lower | title  (data.gov.in field-name case)
MANDI_FILTER_STYLE=lower
# Dated prices up to yesterday: gives the multi-day trend behind SELL_NOW / HOLD.
MANDI_HISTORY_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24

# --- Memory: leave QDRANT_URL empty for in-process (zero setup). Use Qdrant Cloud free tier for persistence.
QDRANT_URL=
QDRANT_API_KEY=
# EMBEDDINGS: hash (offline) | fastembed (pip install fastembed; better semantic search)
EMBEDDINGS=hash

# --- Sign in with Google (optional; leave empty to run without login)
# Create an OAuth "Web application" client at https://console.cloud.google.com/apis/credentials and add your site URLs
# (http://localhost:5173 and the deployed https URL) under "Authorized JavaScript origins". No client secret is needed.
GOOGLE_CLIENT_ID=
# Long random string that signs the login cookie, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SESSION_SECRET=
SESSION_DAYS=14

# --- Database for saved chats + signed-in users (optional). Empty = local SQLite file, which a free Render deploy loses on redeploy.
# Free hosted Postgres: create a project at https://neon.tech and paste its connection string (keep ?sslmode=require).
# If it is set but unreachable the app logs a warning and falls back to SQLite, so the demo still runs.
DATABASE_URL=

# --- App
DOMAIN=farm
CORS_ORIGINS=http://localhost:5173
# Leave empty to keep POST /api/ingest disabled. Set a long random value to enable it (send as X-Admin-Key).
INGEST_API_KEY=
# Chat requests allowed per client+session per minute (0 = off)
RATE_LIMIT_PER_MIN=20

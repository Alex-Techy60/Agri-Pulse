+def test_third_provider_used_when_first_two_fail():
+    calls = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        calls.append(request.url.host)
+        if request.url.host == "f3.test":
+            return httpx.Response(200, json={"choices": [{"message": {"content": "from fallback3"}}]})
+        return httpx.Response(429, json={"error": "rate limited"})
+
+    s = Settings(llm_api_key="k", llm_base_url="https://p.test/v1",
+                 fallback_api_key="k2", fallback_base_url="https://f.test/v1", fallback_model="m",
+                 fallback2_api_key="k3", fallback2_base_url="https://f2.test/v1", fallback2_model="m2",
+                 fallback3_api_key="k4", fallback3_base_url="https://f3.test/v1", fallback3_model="m3")
+    r = LLMClient(s, transport=httpx.MockTransport(handler)).chat([{"role": "user", "content": "x"}])
+    assert r.text == "from fallback3" and r.provider == "fallback3" and r.degraded
+    assert calls[-3:] == ["f.test", "f2.test", "f3.test"]